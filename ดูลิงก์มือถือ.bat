@echo off
chcp 65001 > nul
title ItemBase - ลิงก์สำหรับเปิดบนมือถือและแท็บเล็ต
echo ===================================================================
echo   📱 ITEMBASE - ลิงก์สำหรับเปิดใช้งานบนมือถือ / แท็บเล็ต
echo ===================================================================
echo.

if exist "public-url.txt" (
    set /p URL=<public-url.txt
    echo ลิงก์เว็บไซต์ HTTPS ปัจจุบัน:
    echo.
    echo   %URL%
    echo.
    echo -------------------------------------------------------------------
    echo   - ส่งลิงก์นี้ให้ทีมงานใน LINE เพื่อเปิดบนมือถือหรือ iPad ได้ทันที
    echo   - สามารถใช้งานได้จากทุกที่ ผ่านเน็ต 4G/5G ไม่ต้องต่อ Wi-Fi เดียวกัน
    echo   - รองรับการเปิดกล้องสแกน QR Code ตรวจนับสต็อกสดบนมือถือได้ 100%%
    echo -------------------------------------------------------------------
    echo.
    set /p COPY_OPT="ต้องการเปิดลิงก์นี้ในเบราว์เซอร์เดี๋ยวนี้เลยหรือไม่? (Y/N): "
    if /i "%COPY_OPT%"=="Y" (
        start %URL%
    )
) else (
    echo ยังไม่พบไฟล์ลิงก์ กรุณาเปิดใช้งานระบบด้วยไฟล์ "เริ่มใช้งานระบบ.bat" ก่อนครับ
)

echo.
pause
